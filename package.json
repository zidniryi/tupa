{
  "name": "@zidniryi/tupa",
  "version": "1.1.0",
  "description": "Stash and resume AI agent sessions across Claude Code, Codex, opencode, and more.",
  "type": "module",
  "author": "zidniryi <zidniryi123@gmail.com>",
  "bin": {
    "tupa": "dist/cli.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zidniryi/tupa.git"
  },
  "homepage": "https://github.com/zidniryi/tupa#readme",
  "bugs": {
    "url": "https://github.com/zidniryi/tupa/issues"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsup src/cli.ts --format esm --clean",
    "dev": "tsx src/cli.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test test/**/*.test.ts",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "ai",
    "agent",
    "resume",
